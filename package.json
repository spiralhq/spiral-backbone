{
  "name": "spiral-backbone",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "tsc --noEmit && turbo run check-types",
    "test": "turbo run test",
    "db:push": "turbo run db:push -F @spiral-backbone/db --",
    "db:studio": "turbo run db:studio -F @spiral-backbone/db --",
    "db:generate": "turbo run db:generate -F @spiral-backbone/db --",
    "db:migrate": "turbo run db:migrate -F @spiral-backbone/db --",
    "db:start": "turbo run db:start -F @spiral-backbone/db --",
    "db:watch": "turbo run db:watch -F @spiral-backbone/db --",
    "db:stop": "turbo run db:stop -F @spiral-backbone/db --",
    "db:down": "turbo run db:down -F @spiral-backbone/db --",
    "env:generate": "varlock codegen --path ./packages/db/",
    "postinstall": "varlock codegen --path ./packages/db/",
    "check:boundaries": "node scripts/check-boundaries.ts",
    "test:scripts": "vitest run scripts",
    "check": "oxlint && oxfmt --write && npm run check:boundaries && npm run test:scripts",
    "check:ci": "oxlint && oxfmt --check && npm run check:boundaries && npm run test:scripts"
  },
  "dependencies": {
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@spiral-backbone/config": "*",
    "@types/node": "^26.4.1",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "turbo": "^2.10.12",
    "typescript": "^6.0.3",
    "varlock": "1.18.0",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "@solana/surfpool": {
      "@solana/kit": "^8.3.0",
      "@solana/kit-plugin-rpc": "^0.19.0",
      "@solana/kit-plugin-signer": "^0.19.0"
    }
  },
  "packageManager": "npm@11.19.1",
  "allowScripts": {
    "esbuild": true
  }
}
