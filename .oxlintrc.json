{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "rules": {},
  "env": {
    "builtin": true
  },
  "overrides": [
    {
      "files": [
        "**/packages/eval/src/*.ts",
        "**/packages/eval/src/common/**/*.ts",
        "**/packages/eval/src/h1/**/*.ts",
        "**/packages/eval/src/h2/**/*.ts",
        "**/packages/eval/src/h3/**/*.ts",
        "**/packages/eval/src/report/**/*.ts",
        "**/packages/eval/src/testing/**/*.ts"
      ],
      "rules": {
        "no-restricted-imports": ["error", "@spiral-backbone/db", "@spiral-backbone/indexer"]
      }
    },
    {
      "files": ["**/packages/eval/verifier/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          "@spiral-backbone/protocol",
          "kubo-rpc-client",
          "ipfs-http-client",
          "helia",
          { "patterns": ["../src", "../src/*"] }
        ]
      }
    },
    {
      "files": ["**/packages/cli/src/commands/fetch.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          "@spiral-backbone/db",
          "@spiral-backbone/indexer",
          {
            "patterns": ["../../../db", "../../../db/**", "../../../indexer", "../../../indexer/**"]
          }
        ]
      }
    },
    {
      "files": ["**/packages/cli/src/commands/fetch/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          "@spiral-backbone/db",
          "@spiral-backbone/indexer",
          {
            "patterns": [
              "../../../../db",
              "../../../../db/**",
              "../../../../indexer",
              "../../../../indexer/**"
            ]
          }
        ]
      }
    }
  ]
}
